{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dtr-retailpulse"
		},
		"AzureBlobStorage_ls_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage_ls'"
		},
		"AzureDataLakeStorageLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageLS'"
		},
		"AzureDataLakeStorageLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retailpulsedev.dfs.core.windows.net/"
		},
		"Event_trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/5b59bffa-e56d-4226-9daa-3c709bce7020/resourceGroups/DENG-2/providers/Microsoft.Storage/storageAccounts/retailpulsedev"
		},
		"trigger1_properties_Inject_Sales_Incr pipeline_parameters_starttime": {
			"type": "string",
			"defaultValue": "@pipeline().parameters.TriggerTime"
		},
		"trigger1_properties_Inject_Sales_Incr pipeline_parameters_endtime": {
			"type": "string",
			"defaultValue": "@pipeline().parameters.TriggerTime"
		},
		"trigger1_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/5b59bffa-e56d-4226-9daa-3c709bce7020/resourceGroups/DENG-2/providers/Microsoft.Storage/storageAccounts/retailpulsedev"
		},
		"tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_starttime": {
			"type": "string",
			"defaultValue": "@trigger().startTime"
		},
		"tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_endtime": {
			"type": "string",
			"defaultValue": "@trigger().endTime"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dtr-retailpulse_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage_ls_connectionString": {
						"value": "[parameters('AzureBlobStorage_ls_connectionString')]"
					},
					"AzureDataLakeStorageLS_accountKey": {
						"value": "[parameters('AzureDataLakeStorageLS_accountKey')]"
					},
					"AzureDataLakeStorageLS_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageLS_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "dtr-retailpulse_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Event_trigger_properties_typeProperties_scope": {
						"value": "[parameters('Event_trigger_properties_typeProperties_scope')]"
					},
					"trigger1_properties_Inject_Sales_Incr pipeline_parameters_starttime": {
						"value": "[parameters('trigger1_properties_Inject_Sales_Incr pipeline_parameters_starttime')]"
					},
					"trigger1_properties_Inject_Sales_Incr pipeline_parameters_endtime": {
						"value": "[parameters('trigger1_properties_Inject_Sales_Incr pipeline_parameters_endtime')]"
					},
					"trigger1_properties_typeProperties_scope": {
						"value": "[parameters('trigger1_properties_typeProperties_scope')]"
					},
					"tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_starttime": {
						"value": "[parameters('tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_starttime')]"
					},
					"tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_endtime": {
						"value": "[parameters('tumbling_trigger_properties_Inject_Sales_Incr pipeline_parameters_endtime')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'dtr-retailpulse_ArmTemplate_0')]"
			]
		}
	]
}